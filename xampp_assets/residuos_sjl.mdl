{UTF-8}
********************************************************
	.SUBSISTEMA 1 - GENERACION DE RESIDUOS
********************************************************~
	|

GPC=GPC base * (1 + efecto ingreso GPC )
	~	kg/hab/dia
	~		|

Poblacion= 
	INTEG (
		crecimiento poblacional-decrecimiento poblacional,
		1.191e+06)
	~	hab
	~	Poblacion total de San Juan de Lurigancho
	|

Generacion organicos= 
	INTEG (
		gen organicos-sal organicos,
		514)
	~	ton/dia
	~	Generacion diaria activa de residuos organicos
	~	:SUPPLEMENTARY 
	|

Generacion reciclables= 
	INTEG (
		gen reciclables-sal reciclables,
		308)
	~	ton/dia
	~	Generacion diaria activa de residuos reciclables
	|

Generacion no aprovechables= 
	INTEG (
		gen no aprovechables-sal no aprov,
		205)
	~	ton/dia
	~	Generacion diaria activa de residuos no aprovechables
	~	:SUPPLEMENTARY 
	|

Generacion bruta= 
	INTEG (
		entrada generacion bruta-salida generacion bruta,
		1027)
	~	ton/dia
	~	Nivel agregado: suma de las tasas de los 3 tipos de residuo (patron \
		omnibus/taxis/motos)
	|

crecimiento poblacional= 
	Poblacion * tasa natalidad
	~	hab/anio
	~		|

decrecimiento poblacional= 
	Poblacion * tasa mortalidad
	~	hab/anio
	~		|

gen organicos= 
	Poblacion * GPC * fracc organicos / 1000
	~	ton/dia
	~		|

gen reciclables= 
	Poblacion * GPC * fracc reciclables / 1000
	~	ton/dia
	~		|

gen no aprovechables= 
	Poblacion * GPC * fracc no aprovechables / 1000
	~	ton/dia
	~		|

sal organicos= 
	gen organicos
	~	ton/dia
	~		|

sal reciclables= 
	gen reciclables
	~	ton/dia
	~		|

sal no aprov= 
	gen no aprovechables
	~	ton/dia
	~		|

entrada generacion bruta= 
	gen organicos + gen reciclables + gen no aprovechables
	~	ton/dia
	~	Tasa Total Aumento: suma de las 3 tasas de entrada tipo
	|

salida generacion bruta= 
	sal organicos + sal reciclables + sal no aprov
	~	ton/dia
	~	Tasa Total Disminucion: suma de las 3 tasas de salida tipo
	|

tasa natalidad= 
	0.018
	~	1/anio
	~		|

tasa mortalidad= 
	0.006
	~	1/anio
	~		|

ingreso per capita= 
	1450
	~	soles/hab/anio
	~		|

efecto ingreso GPC= 
	WITH LOOKUP (
		ingreso per capita,
		([(800,0)-(3000,0.35)],(800,0),(1450,0.15),(2200,0.27),(3000,0.35)) )
	~	adimensional
	~	Efecto del ingreso per capita sobre la generacion per capita
	|

GPC base= 
	0.83
	~	kg/hab/dia
	~		|

fracc organicos= 
	0.5
	~	adimensional
	~	Fuente: PIGARS SJL
	|

fracc reciclables= 
	0.3
	~	adimensional
	~	Fuente: PIGARS SJL
	|

fracc no aprovechables= 
	0.2
	~	adimensional
	~	Fuente: PIGARS SJL
	|

generacion bruta anual=
	entrada generacion bruta * 365
	~	ton/anio
	~	Se usa el flujo (no el nivel, que queda congelado en su valor inicial \
		porque su entrada y salida son identicas) para que la generacion anual \
		si responda al crecimiento poblacional
	|

potencial reciclaje=
	gen reciclables * 365
	~	ton/anio
	~	Techo fisico maximo de lo reciclable. Se usa el flujo gen reciclables \
		(no el nivel Generacion reciclables, que queda congelado) para que \
		responda al crecimiento poblacional
	|

********************************************************
	.SUBSISTEMA 2 - RECOLECCION Y FLOTA VEHICULAR
********************************************************~
	|

Residuos dispersos= 
	INTEG (
		acumulacion dispersos-limpieza dispersos,
		9900)
	~	ton
	~		~	:SUPPLEMENTARY 
	|

Compactadores= 
	INTEG (
		adq compactadores-retiro compactadores,
		28)
	~	unidades
	~		|

Volquetes= 
	INTEG (
		adq volquetes-retiro volquetes,
		15)
	~	unidades
	~		|

Barandas= 
	INTEG (
		adq barandas-retiro barandas,
		9)
	~	unidades
	~		|

Flota operativa= 
	INTEG (
		entrada flota-salida flota,
		52)
	~	unidades
	~	Nivel agregado: suma de las tasas de los 3 tipos de vehiculo (patron \
		omnibus/taxis/motos)
	|

acumulacion dispersos= 
	MAX(0, generacion bruta anual - recoleccion efectiva)
	~	ton/anio
	~		|

limpieza dispersos= 
	Flota operativa * cap camion * efic rutas * 365 * fracc limpieza
	~	ton/anio
	~		|

adq compactadores= 
	inversion flota * fracc compactadores / costo compactador
	~	unid/anio
	~		|

adq volquetes= 
	inversion flota * fracc volquetes / costo volquete
	~	unid/anio
	~		|

adq barandas= 
	inversion flota * fracc barandas / costo baranda
	~	unid/anio
	~		|

retiro compactadores= 
	Compactadores / vida util compactador
	~	unid/anio
	~		|

retiro volquetes= 
	Volquetes / vida util volquete
	~	unid/anio
	~		|

retiro barandas= 
	Barandas / vida util baranda
	~	unid/anio
	~		|

entrada flota= 
	adq compactadores + adq volquetes + adq barandas
	~	unid/anio
	~	Tasa Total Aumento: suma de las 3 tasas de adquisicion tipo
	|

salida flota= 
	retiro compactadores + retiro volquetes + retiro barandas
	~	unid/anio
	~	Tasa Total Disminucion: suma de las 3 tasas de retiro tipo
	|

costo compactador= 
	320000
	~	soles/unidad
	~		|

costo volquete= 
	180000
	~	soles/unidad
	~		|

costo baranda= 
	120000
	~	soles/unidad
	~		|

vida util compactador= 
	8
	~	anio
	~		|

vida util volquete= 
	7
	~	anio
	~		|

vida util baranda= 
	6
	~	anio
	~		|

fracc compactadores= 
	0.55
	~	adimensional
	~		|

fracc volquetes= 
	0.3
	~	adimensional
	~		|

fracc barandas= 
	0.15
	~	adimensional
	~		|

cap camion= 
	8
	~	ton/dia/unidad
	~		|

efic rutas= 
	WITH LOOKUP (
		densidad urbana,
		([(5000,0.6)-(12000,0.85)],(5000,0.6),(8000,0.72),(12000,0.85)) )
	~	adimensional
	~		|

densidad urbana= 
	Poblacion / 131.25
	~	hab/km2
	~		|

fracc limpieza= 
	0.15
	~	adimensional
	~	Fraccion de flota dedicada a puntos criticos
	|

recoleccion efectiva= 
	generacion bruta anual * cobertura recoleccion
	~	ton/anio
	~		|

cobertura recoleccion= 
	MIN(1, Flota operativa * cap camion * 365 / generacion bruta anual)
	~	adimensional
	~		|

inversion flota= 
	Presupuesto disponible * fracc presupuesto flota * (1 + presion inversion flota)
	~	soles/anio
	~		|

fracc presupuesto flota= 
	0.18
	~	adimensional
	~		|

Obj cobertura= 
	0.9
	~	adimensional
	~	Meta Ley 1278
	|

Discrep cobertura= 
	MAX(0, Obj cobertura - cobertura recoleccion)
	~	adimensional
	~		|

tiempo ajuste flota= 
	3
	~	anio
	~	Retardo de respuesta
	|

presion inversion flota= 
	MAX(0, Discrep cobertura) / tiempo ajuste flota
	~	1/anio
	~		|

********************************************************
	.SUBSISTEMA 3 - DISPOSICION FINAL (RELLENOS SANITARIOS)
********************************************************~
	|

Volumen Portillo= 
	INTEG (
		entrada portillo-salida Portillo,
		2.2e+07)
	~	m3
	~		|

Volumen Huaycoloro= 
	INTEG (
		entrada huaycoloro-salida Huaycoloro,
		1.6e+07)
	~	m3
	~		|

Volumen relleno total= 
	INTEG (
		entrada relleno total-salida relleno total,
		3.8e+07)
	~	m3
	~	Nivel agregado: suma de las tasas de los 2 rellenos (patron \
		omnibus/taxis/motos)
	|

entrada portillo= 
	necesidad disposicion * fracc portillo
	~	m3/anio
	~		|

entrada huaycoloro= 
	necesidad disposicion * fracc huaycoloro
	~	m3/anio
	~		|

salida Portillo= 
	0
	~	m3/anio
	~		|

salida Huaycoloro= 
	0
	~	m3/anio
	~		|

entrada relleno total= 
	entrada portillo + entrada huaycoloro
	~	m3/anio
	~	Tasa Total Aumento: suma de las tasas de entrada de los 2 rellenos
	|

salida relleno total= 
	salida Portillo + salida Huaycoloro
	~	m3/anio
	~	Tasa Total Disminucion: los rellenos sanitarios no se vacian
	|

necesidad disposicion= 
	MAX(0, (recoleccion efectiva - valorizacion total) / densidad compactacion)
	~	m3/anio
	~	Volumen que necesita disposicion final, antes de repartirse entre rellenos
	|

cap Portillo= 
	4.2e+07
	~	m3
	~		|

cap Huaycoloro= 
	2.8e+07
	~	m3
	~		|

uso Portillo= 
	Volumen Portillo / cap Portillo
	~	adimensional
	~		|

uso Huaycoloro= 
	Volumen Huaycoloro / cap Huaycoloro
	~	adimensional
	~		~	:SUPPLEMENTARY 
	|

fracc portillo= 
	IF THEN ELSE(uso Portillo < 0.95, 0.65, 0)
	~	adimensional
	~		|

fracc huaycoloro= 
	1 - fracc portillo
	~	adimensional
	~		|

vida util Portillo= 
	(cap Portillo - Volumen Portillo) / (entrada portillo + 0.001)
	~	anio
	~		|

vida util Huaycoloro= 
	(cap Huaycoloro - Volumen Huaycoloro) / (entrada huaycoloro + 0.001)
	~	anio
	~		|

vida util remanente= 
	MIN(vida util Portillo, vida util Huaycoloro)
	~	anio
	~		|

densidad compactacion= 
	0.8
	~	ton/m3
	~		|

ocup promedio= 
	Volumen relleno total / (cap Portillo + cap Huaycoloro)
	~	adimensional
	~		|

factor saturacion= 
	WITH LOOKUP (
		ocup promedio,
		([(0,0)-(1,3)],(0,0),(0.5,0.4),(0.8,1.2),(1,3)) )
	~	adimensional
	~		|

costo unit disposicion= 
	costo base disposicion * (1 + factor saturacion)
	~	US$/ton
	~		|

costo base disposicion= 
	10.3
	~	US$/ton
	~		|

Obj vida util= 
	15
	~	anio
	~	Minimo de planificacion
	|

Discrep vida util= 
	MAX(0, Obj vida util - vida util remanente)
	~	anio
	~		|

tiempo decision ampliar= 
	5
	~	anio
	~	Licitacion + construccion
	|

presion ampliar cap= 
	MAX(0, Discrep vida util) / tiempo decision ampliar
	~	anio/anio
	~		~	:SUPPLEMENTARY 
	|

********************************************************
	.SUBSISTEMA 4 - VALORIZACION (RECICLAJE)
********************************************************~
	|

Recicladores formalizados= 
	INTEG (
		formalizacion-desercion,
		680)
	~	personas
	~		|

formalizacion= 
	MAX(0, recicladores informales - Recicladores formalizados) * fracc formalizable * efecto presupuesto form\
		 * (1 + presion formalizacion)
	~	personas/anio
	~		|

desercion= 
	Recicladores formalizados * tasa desercion
	~	personas/anio
	~		|

recicladores informales= 
	40000
	~	personas
	~	Estimado Lima
	|

fracc formalizable= 
	0.008
	~	1/anio
	~	Ritmo base sin politica
	|

tasa desercion= 
	0.05
	~	1/anio
	~		|

productividad reciclador= 
	0.12
	~	ton/dia/persona
	~		|

valorizacion total= 
	Recicladores formalizados * productividad reciclador * 365
	~	ton/anio
	~		|

tasa reciclaje= 
	valorizacion total / generacion bruta anual
	~	adimensional
	~		~	:SUPPLEMENTARY 
	|

precio material reciclable= 
	850
	~	soles/ton
	~		|

ingreso reciclaje= 
	valorizacion total * precio material reciclable
	~	soles/anio
	~		|

efecto presupuesto form= 
	WITH LOOKUP (
		Presupuesto disponible / presupuesto obj,
		([(0,0.1)-(2,1.8)],(0,0.1),(1,1),(2,1.8)) )
	~	adimensional
	~		|

Obj reciclaje= 
	potencial reciclaje
	~	ton/anio
	~	Techo fisico real, reemplaza meta politica del 20%
	|

Discrep reciclaje= 
	MAX(0, Obj reciclaje - valorizacion total)
	~	ton/anio
	~		|

voluntad politica= 
	0.5
	~	adimensional
	~	Ajustable 0 a 1
	|

presion formalizacion= 
	Discrep reciclaje / Obj reciclaje * voluntad politica
	~	adimensional
	~		|

********************************************************
	.SUBSISTEMA 5 - FINANCIAMIENTO MUNICIPAL
********************************************************~
	|

Presupuesto disponible= 
	INTEG (
		ingreso presupuestal-gasto operativo,
		4.3e+07)
	~	soles
	~		|

Morosidad= 
	INTEG (
		aumento morosidad-reduccion morosidad,
		0.82)
	~	adimensional
	~		|

ingreso presupuestal= 
	recaudacion efectiva + transferencias MEF + ingreso reciclaje + presion ajuste fiscal
	~	soles/anio
	~		|

gasto operativo= 
	costo recoleccion anual + costo disposicion anual + costo formalizacion
	~	soles/anio
	~		|

aumento morosidad= 
	MAX(0, morosidad deseada - Morosidad) / tiempo ajuste morosidad
	~	1/anio
	~		|

reduccion morosidad= 
	MAX(0, Morosidad - morosidad deseada) / tiempo ajuste morosidad
	~	1/anio
	~		|

morosidad deseada= 
	0.95 - efecto cobertura morosidad
	~	adimensional
	~		|

efecto cobertura morosidad= 
	WITH LOOKUP (
		cobertura recoleccion,
		([(0,0)-(1,0.6)],(0,0),(0.5,0.3),(1,0.6)) )
	~	adimensional
	~		|

tiempo ajuste morosidad= 
	2
	~	anio
	~		|

arbitrios potenciales= 
	Poblacion * arbitrio por habitante
	~	soles/anio
	~		|

arbitrio por habitante= 
	120
	~	soles/hab/anio
	~		|

recaudacion efectiva= 
	arbitrios potenciales * (1 - Morosidad)
	~	soles/anio
	~		|

transferencias MEF= 
	1.8e+07
	~	soles/anio
	~	Constante ajustable
	|

costo recoleccion anual= 
	recoleccion efectiva * costo por ton recoleccion
	~	soles/anio
	~		|

costo por ton recoleccion= 
	85
	~	soles/ton
	~		|

costo disposicion anual= 
	entrada relleno total * densidad compactacion * costo unit disposicion * tipo cambio
	~	soles/anio
	~		|

tipo cambio= 
	3.8
	~	soles/US$
	~		|

costo formalizacion= 
	formalizacion * costo por reciclador formalizado
	~	soles/anio
	~		|

costo por reciclador formalizado= 
	2400
	~	soles/persona/anio
	~		|

deficit financiero= 
	MAX(0, gasto operativo - ingreso presupuestal)
	~	soles/anio
	~		~	:SUPPLEMENTARY 
	|

presupuesto per capita= 
	Presupuesto disponible / Poblacion
	~	soles/hab
	~		|

presupuesto obj= 
	Poblacion * 80
	~	soles
	~	Meta: S/80 por habitante al anio
	|

Obj presupuesto pc= 
	80
	~	soles/hab
	~	Referencia Lima Metropolitana
	|

Discrep financiera= 
	MAX(0, Obj presupuesto pc - presupuesto per capita)
	~	soles/hab
	~		|

capacidad endeudamiento= 
	0.3
	~	adimensional
	~	Fraccion del deficit cubierta
	|

presion ajuste fiscal= 
	Discrep financiera * Poblacion * capacidad endeudamiento
	~	soles/anio
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 2040
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 2019
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  = 
	1
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.25
	~	Year [0,?]
	~	The time step for the simulation.
	|

