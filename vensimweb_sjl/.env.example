# Configuración de la base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vensimweb_sjl

# Token de ngrok (obtén uno gratis en https://ngrok.com/)
